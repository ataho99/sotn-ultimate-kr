# 한글 이미지 빌드 환경 고정 — 모든 래퍼는 이 파일만 source
# 값은 성공한 빌드의 환경을 그대로 옮긴 것(PSP 칸 일본어 음성, XA 교체표 포함)
if [ -f ~/.profile ]; then source ~/.profile; fi
export GOTOOLCHAIN=local NODE=/usr/bin/node PSP_DUB_JP=1   # PSP칸=일본어. 빠지면 XA_STR1 +5,904섹터
export MOD_PSP_DUB=1
export DUB_FLAGS="--dub build/us/psp_dub/dub.json --dub-jp build/us/jp_dub/dub.json"
# 아래 --swap-jp 표(P127_교체표_0x3F6추가.tsv)는 저장소의 ko_data/recipe/ 에 있다. --swap-span 파일(p110_jp_xa_span.bin)은
# 저장소에 없다: 일본판 PS1 디스크 이미지(SLPM-86023)에서 잘라 낸 XA 범위 파일(sha1 cf89a5127ea97b67d1791236e92b23159313b4f3,
# repack_xa.py 가 이 값을 대조한다)이며, 재료에서 만들어 KO_WK/recipe/ 에 같은 이름으로 둔다.
export REPACK_XA_FLAGS="--swap-jp ${KO_WK}/recipe/P127_교체표_0x3F6추가.tsv --swap-span ${KO_WK}/recipe/p110_jp_xa_span.bin --swap-report ${PWD}/build/p166/swap_report_49c.json"  # 빠지면 XA_STR1 +7,680섹터(JP PS1 take 교체·mono 절약 누락)
export GENH_SHA=70a968ca3ff26fdd063a8665441e8d9cbc05e879
export P148_TRACE_DIR=${PWD}/build/p166
export SOTN_U_IMAGE=${SOTN_U_IMAGE:?재료 폴더의 SOTN_Ultimate_v1.4.bin 경로를 SOTN_U_IMAGE 로 지정}
export JP_T1=build/jp_t1/jp_t1.bin
